#!/usr/bin/env bash
# One entry point for trying qcc out locally. Works from any shell: outside the nix
# dev shell it re-runs itself inside it.
#
#   ./dev             build and run qccd in the foreground (data in ./.dev)
#   ./dev demo        start a daemon, run a few echo threads through it, stop it
#   ./dev qcc ARGS    run the CLI against the dev daemon, e.g. ./dev qcc thread list
#   ./dev desktop     build and open the desktop app against the dev daemon
#
# Every command that builds also restarts a dev daemon left running from an older
# build; if agents are working in it, it asks first.
#   ./dev check       fmt, clippy and all tests
#   ./dev test [ARGS] cargo test --workspace [ARGS]
#   ./dev clean       remove ./.dev (the dev daemon's journal and plugins)
set -euo pipefail
cd "$(dirname "$0")"

# The desktop app needs the GUI libraries of its own shell.
if [[ "${1:-}" == desktop && -z "${QCC_DESKTOP_SHELL:-}" ]] && command -v nix >/dev/null; then
  exec nix develop .#desktop --command env QCC_DESKTOP_SHELL=1 "$0" "$@"
fi

if [[ -z "${IN_NIX_SHELL:-}" ]] && command -v nix >/dev/null; then
  exec nix develop --command "$0" "$@"
fi

# The dev daemon keeps everything in the repository, away from ~/.local/share/qcc.
export QCC_DATA_DIR="$PWD/.dev"
export QCC_SOCKET="$QCC_DATA_DIR/qccd.sock"
# This script may itself run inside an agent session; do not adopt its thread.
unset QCC_THREAD_ID

# Build, then make sure a dev daemon left running is the one just built.
build() {
  cargo build --quiet -p qcc-daemon -p qcc-cli
  restart_stale_daemon
}
qcc() { ./target/debug/qcc "$@"; }

wait_for_daemon() {
  for _ in $(seq 100); do
    qcc daemon status >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  echo "qccd did not start; see $QCC_DATA_DIR/qccd.log" >&2
  return 1
}

# A daemon started from an older build keeps running its old code after a rebuild
# (cargo replaces the file, the process keeps the old one), and the app talks to
# whatever answers on the socket. Stop it so the new build takes over; if agents
# are at work in it, say so and ask first.
restart_stale_daemon() {
  local status pid
  status=$(qcc daemon status --json 2>/dev/null) || return 0
  pid=$(sed -n 's/.*"pid":\([0-9]*\).*/\1/p' <<<"$status")
  [[ -n "$pid" && -e "/proc/$pid/exe" ]] || return 0
  # Same inode: the running daemon is the file just built.
  if [[ "$(stat -L -c %i "/proc/$pid/exe")" == "$(stat -c %i ./target/debug/qccd)" ]]; then
    return 0
  fi

  local active
  active=$(qcc thread list 2>/dev/null | awk '$2 == "active"') || active=""
  if [[ -n "$active" ]]; then
    echo "The dev daemon (pid $pid) is from an older build, and agents are working in it:" >&2
    sed 's/^/  /' <<<"$active" >&2
    echo "Restarting it interrupts their turns; they can be resumed with a new message." >&2
    if [[ ! -t 0 ]]; then
      echo "Not restarting it (no terminal to ask). Stop it yourself: kill $pid" >&2
      return 0
    fi
    local answer
    read -r -p "Restart it now? [y/N] " answer
    if [[ "$answer" != [yY]* ]]; then
      echo "Keeping the old daemon; the app will say it is outdated until it is stopped (kill $pid)." >&2
      return 0
    fi
  fi

  echo "restarting the dev daemon (pid $pid): it is from an older build" >&2
  kill "$pid"
  for _ in $(seq 100); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "qccd (pid $pid) did not stop; stop it yourself and run this again" >&2
    exit 1
  fi
  # `./dev run` and `./dev desktop` start the new one themselves; the rest need it now.
  case "$command" in
    run | desktop) ;;
    *)
      # Its own session: it outlives this terminal, like one the app starts.
      setsid ./target/debug/qccd 2>>"$QCC_DATA_DIR/qccd.log" </dev/null >/dev/null &
      wait_for_daemon
      ;;
  esac
}

command="${1:-run}"
shift || true

case "$command" in
  run)
    build
    echo "qccd: data in $QCC_DATA_DIR — in another terminal: ./dev qcc thread spawn --provider echo --prompt hi --follow" >&2
    exec ./target/debug/qccd "$@"
    ;;
  qcc)
    build
    exec ./target/debug/qcc "$@"
    ;;
  demo)
    build
    mkdir -p "$QCC_DATA_DIR"
    if qcc daemon status >/dev/null 2>&1; then
      echo "using the dev daemon that is already running" >&2
    else
      ./target/debug/qccd 2>"$QCC_DATA_DIR/qccd.log" &
      daemon=$!
      trap 'kill "$daemon" 2>/dev/null; wait "$daemon" 2>/dev/null || true' EXIT
      wait_for_daemon
    fi
    run() { echo; echo "\$ qcc $*"; qcc "$@"; }
    run plugin list
    run thread spawn --provider echo --prompt 'hello from qcc' --follow
    run thread spawn --provider echo --prompt '/tool grep' --follow
    run thread spawn --provider echo --prompt '/exec echo output of a real process' --follow
    run thread list
    ;;
  desktop)
    # The app starts the qccd that sits next to its own binary.
    build
    cd apps/desktop
    pnpm install --frozen-lockfile
    exec cargo tauri dev "$@"
    ;;
  check)
    exec ./scripts/check.sh
    ;;
  test)
    exec cargo test --workspace --exclude qcc-desktop "$@"
    ;;
  clean)
    if qcc daemon status >/dev/null 2>&1; then
      echo "the dev daemon is running; stop it first" >&2
      exit 1
    fi
    rm -rf "$QCC_DATA_DIR"
    ;;
  *)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
