/// The qcc plugin contract.
///
/// A plugin is a WebAssembly component that exports two functions: `init`, which
/// declares what the plugin contributes, and `handle`, which receives every event
/// addressed to it. Each plugin instance is a single-threaded actor: events are
/// delivered one at a time, and nothing a plugin imports ever blocks on the outside
/// world. Long-running things (an agent process writing to stdout, a timer) come back
/// as events, and a request that has to wait for one is answered later (`deferred`).
///
/// Every import but `log`, `completions` and `views` is gated by a permission the
/// plugin requests in its manifest, and so are the events about every thread
/// (`turn-ended`: `turn-events`; `thread-changed`: `thread-events`).
package qcc:plugin@0.3.0;

/// The vocabulary shared by imports and exports.
interface types {
  /// Minted by the daemon; opaque to the plugin, echoed verbatim.
  type thread-id = string;
  /// A JSON document encoded as text.
  type json = string;

  // ----- the delta grammar ------------------------------------------------------
  //
  // A provider bridge parses its agent's dialect into these semantic deltas. It never
  // mints timeline ids and never tracks the timeline: the core's assembler does.

  record token-usage {
    input-tokens: u64,
    output-tokens: u64,
    cached-input-tokens: option<u64>,
  }

  /// Cumulative session total plus the last request.
  record usage-snapshot {
    total: token-usage,
    last: token-usage,
    model-context-window: option<u64>,
    /// Tokens the context holds now, when the agent says or the bridge can tell.
    /// Token counts differ in meaning between agents (whether cached input is part
    /// of input, whether a report covers one request or several), so only the
    /// bridge knows how full the context is.
    context-used: option<u64>,
  }

  /// Provider-side identity of an item within a session.
  variant item-key {
    /// The provider names its items (a tool-call id, a message id).
    provider(string),
    /// An anonymous text stream named by the bridge (`assistant`, `thinking-2`).
    /// Released when the stream closes or a non-text item opens.
    anonymous(string),
  }

  enum text-channel { agent-message, reasoning, plan }
  /// How a closed item ended; an item is only ever closed in a terminal state.
  enum item-status { completed, failed, declined, interrupted }
  enum turn-status { completed, failed, interrupted }

  record command-item {
    command: string,
    cwd: option<string>,
    output: option<string>,
    exit-code: option<s32>,
  }

  record file-change-item {
    path: string,
    diff: option<string>,
  }

  record tool-item {
    name: string,
    input: json,
    output: option<string>,
    /// The MCP server the tool belongs to, for a tool of one.
    mcp-server: option<string>,
    /// The skill the call puts to use, for a call that loads one.
    skill: option<string>,
  }

  /// A plugin-defined item; `kind` is `<plugin-id>/<name>`.
  record extension-item {
    kind: string,
    payload: json,
  }

  variant item-shape {
    agent-message(string),
    reasoning(string),
    plan(string),
    command(command-item),
    file-change(file-change-item),
    file-read(string),
    search(string),
    tool(tool-item),
    extension(extension-item),
  }

  enum option-kind { allow, deny, other }

  record interaction-option {
    id: string,
    label: string,
    kind: option-kind,
  }

  record approval-request {
    title: string,
    detail: option<string>,
    options: list<interaction-option>,
  }

  record question-request {
    question: string,
    options: list<interaction-option>,
    allow-text: bool,
  }

  variant interaction-request {
    approval(approval-request),
    question(question-request),
  }

  variant interaction-resolution {
    /// The id of the chosen option.
    selected(string),
    text(string),
    /// Nobody answered: the turn settled or the session went away first.
    cancelled,
  }

  record turn-boundary {
    status: turn-status,
    error: option<string>,
    /// With no turn open, own one only if submitted input is still waiting for a turn.
    claim-if-idle: bool,
    /// Where the session stands once the turn is over, in the provider's own terms
    /// (a message id, a turn id): what a fork from this turn starts from, handed
    /// back as `session-start.fork-at`. Only from a provider that forks.
    point: option<string>,
  }

  record item-open {
    key: item-key,
    shape: item-shape,
  }

  /// Always carries the full terminal shape.
  record item-close {
    key: item-key,
    shape: item-shape,
    status: item-status,
  }

  record text-delta {
    key: item-key,
    channel: text-channel,
    text: string,
  }

  record text-close {
    key: item-key,
    channel: text-channel,
    /// The provider-final text; absent, the streamed text stands.
    text: option<string>,
  }

  record interaction-ask {
    /// The provider-side handle the resolution comes back with.
    request-id: string,
    /// The item the request is about, if any.
    item: option<item-key>,
    request: interaction-request,
  }

  enum mcp-state {
    /// The agent is still connecting.
    starting,
    ready,
    failed,
    /// The server wants the user to sign in, in the agent itself.
    needs-auth,
    /// Turned off for this session.
    disabled,
  }

  record mcp-status {
    name: string,
    state: mcp-state,
    /// Why it failed, in the agent's words.
    error: option<string>,
  }

  /// The agent summed up its conversation so far to make room in its context.
  record compaction {
    /// The agent did it on its own, its context being full; not asked to.
    automatic: bool,
    /// About how many tokens the context held before and after.
    tokens-before: option<u64>,
    tokens-after: option<u64>,
  }

  /// Where a usage window stands, as the agent's service says.
  enum limit-status {
    allowed,
    /// Past a warning threshold, still allowed.
    warning,
    /// The limit is reached.
    exceeded,
  }

  /// One usage window of the account's subscription: a share of an allowance that
  /// starts over at a set time.
  record limit-window {
    /// Stable within the provider: a later report of the same id replaces this one.
    id: string,
    /// How the service names the window, for people (`5-hour`, `Weekly`).
    label: string,
    /// What the window is limited to when not everything counts against it (a
    /// model); absent for the account's main windows.
    scope: option<string>,
    /// How much of the allowance is spent, in percent; can go past 100.
    used-percent: u32,
    /// When the window starts over, in milliseconds since the Unix epoch.
    resets-at: option<u64>,
    window-minutes: option<u64>,
    status: option<limit-status>,
  }

  /// How much of its account's usage limits the agent has spent. Limits belong to
  /// the account, not to a thread; the core keeps the latest per provider.
  record rate-limits {
    /// The subscription the account is on (`max`, `plus`), when known.
    plan: option<string>,
    windows: list<limit-window>,
    /// Every window the account has is listed; otherwise only the listed windows
    /// are updated and the others are kept.
    complete: bool,
  }

  /// What a part of the context window is: only `used` parts are in the context.
  enum context-kind {
    used,
    /// What is left of the window.
    free,
    /// Room the agent keeps for compacting.
    buffer,
    /// Known to the agent but loaded only when needed; not in the window now.
    deferred,
  }

  /// One part of the context window.
  record context-category {
    /// Well-known ids: `system_prompt`, `system_tools`, `mcp_tools`, `memory_files`,
    /// `skills`, `custom_agents`, `messages`, `autocompact_buffer`, `free_space`.
    id: string,
    /// How the agent names the part.
    name: string,
    tokens: u64,
    kind: context-kind,
  }

  /// One thing within a part: a memory file, an MCP tool, a skill.
  record context-entry {
    /// The id of the part it belongs to.
    category: string,
    name: string,
    tokens: u64,
  }

  /// What the context window holds, part by part.
  record context-usage {
    /// Tokens the context holds: the `used` parts together.
    used: u64,
    window: option<u64>,
    /// The parts are reckoned by the bridge rather than counted by the agent.
    estimated: bool,
    categories: list<context-category>,
    /// What the larger parts are made of, largest first within a part.
    entries: list<context-entry>,
  }

  variant delta {
    /// The provider took a prompt. Items never open a turn; only this does.
    turn-open,
    turn-boundary(turn-boundary),
    item-open(item-open),
    item-close(item-close),
    /// Streamed text; opens the item on first sight of the key.
    item-text-delta(text-delta),
    item-text-close(text-close),
    usage(usage-snapshot),
    interaction-request(interaction-ask),
    /// The durable handle of this provider session, for a bridge that learns it only
    /// after `start` returned. Equivalent to returning it from `start`.
    session-identity(string),
    /// A fresh provider session was constructed: provider-native ids start over.
    session-reset,
    /// The provider session is gone, with an optional reason.
    session-ended(option<string>),
    /// How one MCP server of the session is doing now, the agent's own servers
    /// included. A fresh session (`session-reset`) starts with none known.
    mcp-status(mcp-status),
    /// An MCP server left the session (`set-mcp-servers` dropped it): it is no
    /// longer listed.
    mcp-removed(string),
    /// What the context window holds now, part by part. Only from a provider that
    /// declares `context-usage`.
    context-usage(context-usage),
    /// The agent compacted its context, asked to (`compact`) or on its own.
    context-compacted(compaction),
    /// The account's usage limits, as the agent reported them during the session.
    /// Only from a provider that declares `rate-limits`.
    rate-limits(rate-limits),
    provider-error(string),
    provider-warning(string),
    /// Provider traffic the bridge did not recognise, kept for diagnostics.
    unhandled(json),
  }

  // ----- contributions ----------------------------------------------------------

  /// How much the agent may do without asking the user.
  enum permission-mode {
    /// The agent only reads and looks around: nothing that changes a file or the
    /// system runs, and the user is never asked. A provider declares it only if it
    /// can enforce both, not just tell the agent.
    read-only,
    /// Everything the agent wants approved is asked of the user.
    ask,
    /// File edits inside the working directory go through; the rest is asked.
    accept-edits,
    /// The provider's own automatic reviewer decides; the user is not asked.
    auto,
    /// Nothing is asked and nothing is sandboxed.
    full,
  }

  /// From which points of its sessions a provider forks them: starts a new session
  /// whose conversation is an old one's up to there, leaving the old one as it was.
  enum fork-support {
    /// It cannot.
    none,
    /// Only a whole session as it is now: from its latest turn.
    latest,
    /// From the end of any turn whose boundary carried a `point`.
    any,
  }

  /// Session-behaviour facts, reported by the code that implements them.
  record provider-capabilities {
    /// A session can be resumed from its `provider-session` handle.
    resume: bool,
    /// The provider handles `steer`: input fed into the running turn.
    steer: bool,
    /// The permission modes the provider can enforce. A thread is never started in
    /// a mode its provider did not list.
    permission-modes: list<permission-mode>,
    /// The provider changes the MCP servers set up in qcc of a running session
    /// (`set-mcp-servers`): adds, removes and replaces them. Without it, a change
    /// waits for the thread's next session.
    mcp-live: bool,
    /// The provider compacts the session's context when asked (`compact`).
    compact: bool,
    /// The provider can tell which skills its agent finds by itself (`list-skills`).
    list-skills: bool,
    /// The provider reports what its agent's context window holds, part by part
    /// (`context-usage` deltas).
    context-usage: bool,
    /// The agent looks at attached images as images: the provider is given their
    /// bytes (`attachment.data`) and hands them over the way its agent takes them.
    /// Without it, attachments come with their paths only.
    images: bool,
    /// The provider reports its account's usage limits: `rate-limits` deltas during
    /// sessions, and an answer to `read-rate-limits` without one.
    rate-limits: bool,
    /// Whether and from where it forks a session (`session-start.fork-at`). A turn
    /// can be forked from only if its boundary carried a `point`.
    fork: fork-support,
  }

  record provider-info {
    id: string,
    name: string,
    capabilities: provider-capabilities,
    /// The agent's mark, as an SVG document (`<svg xmlns=... viewBox=...>...</svg>`),
    /// that the app draws next to the agent's name at 12 to 16 pixels. Only its
    /// shape counts: the app paints it in the color of the text around it, so a
    /// mark of one color with a transparent background fits best. A mark larger
    /// than 16 KiB or not an SVG is left out. Absent: the app shows the name's
    /// initials.
    icon: option<string>,
  }

  record environment-info {
    id: string,
    name: string,
    /// It can also tell what changed in a directory it did not make, the kind its
    /// environments are made from (for git: uncommitted work against HEAD). Threads
    /// that work in a directory of their own are asked about through it.
    inspects-directories: bool,
    /// It honours `dir`, `branch` and `reuse-branch` of `environment-prepare`: the
    /// user may say where the directory goes and what its branch is called. Those
    /// are never sent to an environment that did not declare this.
    custom-placement: bool,
  }

  /// Where a view appears in the app.
  enum ui-placement {
    /// A screen of its own, next to the overview.
    app,
    /// A tab of the thread view.
    thread-tab,
    /// A tab of the panel beside the thread view: for small views that go along
    /// with the thread, such as its settings in the plugin.
    thread-panel,
  }

  /// Which threads a thread tab or panel view is offered for.
  enum ui-scope {
    all-threads,
    /// Only threads of a provider this plugin contributes.
    own-threads,
  }

  record ui-view-info {
    id: string,
    title: string,
    placement: ui-placement,
    /// Ignored for app views.
    scope: ui-scope,
    /// A page of the plugin's web bundle (the manifest's `web` directory) to show
    /// instead of UI nodes: `index.html`. It runs in a sandboxed frame with no
    /// network and reaches the plugin only by sending actions.
    web: option<string>,
  }

  /// A named value a command takes. Every value is text.
  record command-param {
    name: string,
    label: string,
    required: bool,
    /// A hint shown in an empty field.
    placeholder: option<string>,
    /// The CLI's words without a `--name` go to this parameter, separated by
    /// spaces: `qcc reviewers send f1 f2`. At most one parameter of a command.
    positional: bool,
  }

  /// A command people run from the CLI (`qcc <plugin-id> <id>`) and the app's
  /// command palette.
  record command-info {
    id: string,
    title: string,
    description: string,
    /// The command acts on a thread, which the caller names.
    thread: bool,
    params: list<command-param>,
  }

  /// Instructions for agents. Requires the `skills` permission: what it says can
  /// reach every agent. The user turns a skill off for all threads or for one.
  record skill-info {
    /// Lowercase letters, digits and dashes.
    name: string,
    /// When the agent should read it, in a sentence or two.
    description: string,
    /// Markdown.
    body: string,
    /// Offered only to threads that ask for it (`spawn-options.skills-enabled`, or
    /// the user turning it on in a thread), not to every session.
    on-request: bool,
  }

  /// What a setting holds, which also says how the app asks for it.
  variant setting-kind {
    /// Any text.
    text,
    /// `true` or `false`.
    flag,
    /// One of these values.
    choice(list<string>),
    /// The id of an agent provider.
    provider,
    /// A model of the provider the named setting (a `provider` one) holds.
    model(string),
    /// An effort level of the model the second named setting holds, for the
    /// provider the first one holds.
    effort(tuple<string, string>),
    /// A permission mode: `ask`, `accept-edits`, `auto` or `full`.
    permission-mode,
  }

  /// A setting of the plugin's own, which the user sets in the app's settings or
  /// with `qcc plugin set`. Every value is text; the plugin hears of them through
  /// the `settings` event.
  record setting-field {
    /// Letters, digits, `-` and `_`; unique within the plugin.
    id: string,
    label: string,
    description: option<string>,
    kind: setting-kind,
    /// What the plugin is told while the user has not set it.
    default: option<string>,
  }

  variant contribution {
    provider(provider-info),
    environment(environment-info),
    /// A view the plugin draws from the fixed set of UI nodes.
    ui-view(ui-view-info),
    /// The plugin draws timeline items of this extension kind. The kind must be
    /// the plugin's own: `<plugin-id>/<name>`.
    ui-item(string),
    command(command-info),
    skill(skill-info),
    setting(setting-field),
  }

  // ----- threads ----------------------------------------------------------------

  /// Where a thread is, as far as someone waiting on it cares.
  enum thread-state {
    /// A turn runs, a message waits for one, or the session is starting.
    working,
    /// The agent waits for the user to answer an approval or a question.
    waiting,
    /// Nothing runs; the thread takes input.
    idle,
    /// The provider session could not start or died.
    failed,
    archived,
  }

  record thread-info {
    id: thread-id,
    provider: string,
    cwd: string,
    parent: option<thread-id>,
    title: option<string>,
    /// Kept out of clients' lists (`spawn-options.hidden`).
    hidden: bool,
    model: option<string>,
    /// How hard the model thinks, as the provider names it.
    effort: option<string>,
    /// The contributed environment the thread works in, if any.
    environment: option<string>,
    state: thread-state,
    /// How the latest turn ended.
    last-turn: option<turn-status>,
  }

  /// A watched thread stopped working: it is idle, failed or archived.
  record settled-thread {
    thread: thread-info,
    /// The text of the agent's latest message.
    last-message: option<string>,
  }

  /// Something a person following the thread would notice happened to it: it moved
  /// to another state, a turn ended, or it waits on another request. Wider than
  /// `turn-ended`: it also tells of a thread that starts waiting for the user or
  /// whose session fails without a turn.
  record thread-change {
    /// The thread as it is now.
    thread: thread-info,
    /// Its state when the plugin last heard of it. Absent for a thread that is new
    /// since then.
    previous: option<thread-state>,
    /// A turn ended since the plugin last heard of the thread: `thread.last-turn`
    /// says how. A turn can start and end between two reports, so the state alone
    /// does not tell.
    turn-ended: bool,
    /// The text of the agent's latest message, for a thread that is not working.
    last-message: option<string>,
    /// What the agent waits on, for a waiting thread: the title of the approval or
    /// the question, the oldest one first asked.
    request: option<string>,
  }

  /// A turn of a thread ended. Delivered to plugins with the `turn-events`
  /// permission, for every thread.
  record turn-ended {
    /// The thread as it is once the turn is over. A message that waited for the
    /// turn may already keep it working.
    thread: thread-info,
    status: turn-status,
  }

  /// The answer to `threads.diff`.
  record thread-diff {
    /// The id `threads.diff` returned.
    request: u64,
    thread: thread-id,
    answer: result<environment-diff, string>,
  }

  /// The answer to `threads.changes`.
  record thread-changes {
    /// The id `threads.changes` returned.
    request: u64,
    thread: thread-id,
    answer: result<environment-changes, string>,
  }

  /// The answer to `threads.models`.
  record provider-models {
    /// The id `threads.models` returned.
    request: u64,
    provider: string,
    answer: result<list<model-info>, string>,
  }

  // ----- events -----------------------------------------------------------------

  /// A skill as an agent session gets it: a file it can read.
  record skill-ref {
    name: string,
    description: string,
    /// Absolute path of the skill's `SKILL.md`.
    path: string,
  }

  /// An MCP server the agent connects to, on top of those its own configuration
  /// names.
  record mcp-server {
    /// Letters, digits, `_` and `-`.
    name: string,
    transport: mcp-transport,
  }

  variant mcp-transport {
    /// A program the agent starts and talks to over stdio.
    stdio(mcp-stdio),
    /// A server the agent reaches over streamable HTTP.
    http(mcp-http),
  }

  record mcp-stdio {
    command: string,
    args: list<string>,
    env: list<tuple<string, string>>,
  }

  record mcp-http {
    url: string,
    headers: list<tuple<string, string>>,
  }

  /// A file the user attached to a message. qcc keeps a copy of it; the copy stays
  /// as long as the thread.
  record attachment {
    /// The file name as the user knows it.
    name: string,
    /// Media type, like `image/png`.
    mime: string,
    /// Absolute path of qcc's copy, which the agent can read.
    path: string,
    size: u64,
    /// The file's bytes: given for an image the agent can look at (PNG, JPEG, GIF,
    /// WebP), and only to a provider that declared `images`. A bridge tells its
    /// agent about the other attachments by path (`qcc_plugin_sdk::attachments_note`).
    data: option<list<u8>>,
  }

  record session-start {
    thread: thread-id,
    /// Working directory of the thread.
    cwd: string,
    model: option<string>,
    /// How hard the model thinks: one of the levels its `model-info` lists.
    /// Absent: the agent's own default.
    effort: option<string>,
    /// A `provider-session` handle returned by an earlier start of this thread, or,
    /// with `fork-at`, of the thread it was forked from.
    resume: option<string>,
    /// Fork `resume` instead of continuing it: start a new session whose conversation
    /// is `resume`'s up to this point (a turn boundary's `point`), and leave `resume`
    /// as it was. Only to a provider that declared `fork`, with `resume`; for `latest`,
    /// the point is always that session's latest. The new session's handle is the
    /// one returned, or the `session-identity` reported later; never `resume`.
    fork-at: option<string>,
    /// The first user message, if the session starts with one.
    prompt: option<string>,
    /// What qcc tells the agent along with the first message, as with
    /// `thread-input.notes`.
    prompt-notes: list<string>,
    /// Files attached to the first message, as with `thread-input.attachments`.
    prompt-attachments: list<attachment>,
    /// Absent: the agent's own configuration decides what it may do unasked.
    permission-mode: option<permission-mode>,
    /// Variables the agent process must see (`QCC_THREAD_ID`, `QCC_SOCKET`).
    env: list<tuple<string, string>>,
    /// Skills plugins offer. The bridge tells the agent about them the way its
    /// agent takes extra instructions; `qcc_plugin_sdk::skills_prompt` words it.
    skills: list<skill-ref>,
    /// Other folders of the thread's project (absolute paths). The agent should
    /// see them as part of its work, as its own permission mode allows: the
    /// bridge passes them the way its agent takes extra directories, or tells it
    /// about them (`qcc_plugin_sdk::extra_dirs_prompt`).
    extra-dirs: list<string>,
    /// MCP servers the user set up in qcc and the thread wants: those turned off
    /// for every thread or for this one are left out. The bridge adds them to
    /// those the agent's own configuration names, the way its agent takes them.
    mcp-servers: list<mcp-server>,
  }

  record session-started {
    /// Durable handle that names this provider session across daemon restarts.
    provider-session: option<string>,
  }

  record mcp-servers-update {
    thread: thread-id,
    /// Every MCP server set up in qcc the session should have now. It replaces
    /// what `session-start` or the previous update gave: a server missing here is
    /// to be dropped, a new one connected, one with another configuration
    /// connected again. The agent's own servers stay as they are.
    servers: list<mcp-server>,
  }

  record thread-input {
    thread: thread-id,
    text: string,
    /// Short facts qcc tells the agent along with the message, not written by the
    /// user (what the user is looking at, a skill offered since the session
    /// started). The bridge hands them over the way its agent takes them;
    /// `qcc_plugin_sdk::with_notes` puts them in front of the text.
    notes: list<string>,
    /// Files the user attached to the message.
    attachments: list<attachment>,
  }

  record interaction-answer {
    thread: thread-id,
    request-id: string,
    resolution: interaction-resolution,
  }

  variant provider-request {
    start(session-start),
    /// A user message that starts a turn. The core sends it only while no turn runs.
    input(thread-input),
    /// A user message for the running turn. Sent only to a provider that declared
    /// `steer`, and only while a turn runs.
    steer(thread-input),
    /// Interrupt the running turn. The settling deltas must be emitted before returning.
    interrupt(thread-id),
    /// Release the session. After returning, the plugin holds nothing for the thread.
    stop(thread-id),
    resolve-interaction(interaction-answer),
    /// The models the agent offers. Usually answered `deferred`: asking the agent
    /// means running it.
    list-models,
    /// The skills the agent finds by itself (its own folders, its plugins), as it
    /// reports them. Answered with `skills`, usually `deferred`. The working
    /// directory, when given, is a thread's: the agent's skills there include the
    /// project's own (such as `.claude/skills` or `.agents/skills` in it).
    list-skills(option<string>),
    /// Change the qcc MCP servers of the running session, even mid-turn. Sent only
    /// to a provider that declared `mcp-live`.
    set-mcp-servers(mcp-servers-update),
    /// Compact the session's context: the agent sums up the conversation so far.
    /// Sent only to a provider that declared `compact`, and only while no turn runs.
    /// The work is a turn: open it (`turn-open`), report `context-compacted`, and
    /// settle it.
    compact(thread-id),
    /// The account's usage limits as they are now, asked without a session. Sent
    /// only to a provider that declared `rate-limits`. Answered with `rate-limits`
    /// (a complete report; no windows when the account has no such limits), usually
    /// `deferred`.
    read-rate-limits,
  }

  record provider-call {
    /// Id of the contributed provider the call is for.
    provider: string,
    request: provider-request,
  }

  record environment-prepare {
    thread: thread-id,
    /// The directory the thread was asked to work on.
    source-dir: string,
    /// A directory set aside for this plugin's environments. What goes where inside
    /// it is the plugin's business.
    root: string,
    /// What the new directory starts from; its meaning belongs to the environment
    /// (a git ref, for a git one). Absent: the environment's default.
    base: option<string>,
    /// The thread has been working in `source-dir` and moves into the new
    /// directory: take the work not yet saved there along (uncommitted changes,
    /// for git), leaving `source-dir` without it.
    carry-changes: bool,
    /// Where the user asked the new directory to be: an absolute path without `.`
    /// or `..`. Absent: the plugin picks a place inside `root`. What may already be
    /// there, and what happens to it on removal, is the environment's to decide; it
    /// must never destroy what it did not make.
    dir: option<string>,
    /// What the user asked the environment's line of work to be called (a git
    /// branch, for a git one). Absent: the plugin names it.
    branch: option<string>,
    /// `branch` may exist already, and then the environment continues on it
    /// instead of refusing.
    reuse-branch: bool,
  }

  /// How the work of an environment goes back to the directory it was made from.
  enum deliver-mode {
    /// As changes not yet saved there (uncommitted, for git), for the user to look
    /// at and keep or not.
    apply,
    /// Saved in the environment and merged (a commit and a git merge).
    merge,
  }

  record environment-deliver {
    thread: thread-id,
    cwd: string,
    mode: deliver-mode,
  }

  record environment-remove {
    thread: thread-id,
    cwd: string,
    /// Remove even if work would be lost.
    force: bool,
  }

  record environment-query {
    thread: thread-id,
    cwd: string,
    /// The thread works in `cwd` itself, not in an environment of this plugin: tell
    /// what changed there. Only asked of environments that inspect directories.
    inspect: bool,
    /// Only these files, by their paths as `changes` reports them; every file when
    /// empty. Lets a viewer read the diff of a large change a few files at a time.
    paths: list<string>,
    /// Which part of the work to tell.
    scope: change-scope,
    /// For `diff`: each file whole, its unchanged lines as context around the
    /// changes, instead of a few lines around each change. `changes` ignores it.
    full: bool,
  }

  /// Which part of a thread's work `changes` and `diff` tell.
  variant change-scope {
    /// Everything since the base, saved or not.
    all,
    /// Only what is not saved yet (uncommitted, for git).
    unsaved,
    /// Between saved revisions, by the ids `environment-changes` lists.
    revisions(revision-range),
  }

  record revision-range {
    /// The changes after this revision; absent: after the base.
    %from: option<string>,
    /// Up to this revision, included; absent: up to the directory as it is now,
    /// unsaved work too.
    to: option<string>,
  }

  variant environment-request {
    /// Make the thread's working directory. Answered with `environment-ready`.
    prepare(environment-prepare),
    /// Remove what `prepare` made. Refused if work would be lost, unless forced.
    remove(environment-remove),
    /// What the thread changed. Answered with `environment-changes`.
    changes(environment-query),
    /// The same as one patch. Answered with `environment-diff`.
    diff(environment-query),
    /// Bring the work back to the source directory. Answered with
    /// `environment-delivered`; refused, changing nothing, when it does not fit.
    deliver(environment-deliver),
  }

  record environment-call {
    environment: string,
    request: environment-request,
  }

  enum change-kind { added, modified, deleted, untracked }

  record changed-file {
    /// Relative to the root of the environment.
    path: string,
    kind: change-kind,
    /// Line counts; absent for binary files and files not yet tracked.
    additions: option<u32>,
    deletions: option<u32>,
  }

  record environment-changes {
    /// The branch the directory is on, if it has such a notion.
    branch: option<string>,
    /// What the changes are measured against.
    base: option<string>,
    files: list<changed-file>,
    /// The revisions saved since the base (commits, for git), newest first; empty
    /// for an environment without such a notion. Their ids name a `revision-range`.
    revisions: list<revision>,
  }

  record revision {
    id: string,
    /// One line about it (a commit's subject).
    title: string,
    /// When it was made, in milliseconds since the Unix epoch.
    time: option<u64>,
  }

  record environment-diff {
    /// A unified diff of everything the thread changed.
    diff: string,
    /// The diff was cut short because it is too large.
    truncated: bool,
  }

  record ui-render {
    view: string,
    /// The thread a thread tab is shown for.
    thread: option<thread-id>,
  }

  record ui-action {
    view: string,
    thread: option<thread-id>,
    /// The action named by the node the user activated.
    action: string,
    /// What the node carried: a button's value, the text of an input.
    value: option<string>,
  }

  record ui-item {
    kind: string,
    /// The item's payload, as JSON.
    payload: string,
  }

  /// Every request is answered with `ui-tree`.
  variant ui-request {
    render(ui-render),
    /// The user activated a node. The answer replaces the view.
    action(ui-action),
    render-item(ui-item),
  }

  record command-call {
    command: string,
    /// Set for a command that acts on a thread.
    thread: option<thread-id>,
    /// Parameter values by name. Required ones are always present.
    args: list<tuple<string, string>>,
  }

  record command-result {
    /// What happened, in a sentence, for the person who ran the command.
    message: string,
    /// A thread the command made, which the app opens.
    thread: option<thread-id>,
    /// What the command found, as JSON, for programs: `qcc … --json` prints it.
    data: option<json>,
  }

  record process-output {
    process: u64,
    data: list<u8>,
  }

  record process-exit {
    process: u64,
    /// Absent when the process was killed by a signal.
    code: option<s32>,
  }

  variant event {
    provider(provider-call),
    environment(environment-call),
    ui(ui-request),
    /// Answered with `command-result`.
    command(command-call),
    /// A thread passed to `threads.watch` settled.
    thread-settled(settled-thread),
    /// A turn of some thread ended (permission `turn-events`).
    turn-ended(turn-ended),
    /// The diff asked for with `threads.diff`.
    thread-diff(thread-diff),
    /// The models asked for with `threads.models`.
    provider-models(provider-models),
    /// The changed files asked for with `threads.changes`.
    thread-changes(thread-changes),
    /// The comments on a thread's changes changed: left, resolved, reopened, sent
    /// to the agent or deleted, by anyone (permission `comments`).
    comments-changed(thread-id),
    /// Any thread changed (`thread-change` says how). Delivered to every plugin with
    /// the `thread-events` permission, for every thread, hidden ones included,
    /// from the moment the plugin starts; what happened before is not replayed.
    thread-changed(thread-change),
    process-stdout(process-output),
    process-stderr(process-output),
    /// Delivered after all output of the process.
    process-exit(process-exit),
    /// A timer started with `timers.start` fired.
    timer(u64),
    /// The plugin's settings, by id: what the user set, and the default of each
    /// one not set. Delivered once the daemon is up and whenever the user changes
    /// one.
    settings(list<tuple<string, string>>),
  }

  record model-info {
    /// What the agent is started with (`--model`, a config value).
    id: string,
    name: string,
    description: option<string>,
    /// The model the agent uses when none is chosen.
    is-default: bool,
    /// The effort levels the model takes, from the least to the most thinking.
    /// Empty: effort cannot be chosen for it.
    efforts: list<string>,
    /// The level the model runs at when none is chosen.
    default-effort: option<string>,
  }

  /// A skill an agent finds by itself, not one qcc gives it.
  record agent-skill {
    name: string,
    description: string,
    /// Where the agent has it from, in its own words (`user`, a plugin, a folder).
    source: option<string>,
    /// Its `SKILL.md`, when the agent says.
    path: option<string>,
  }

  variant outcome {
    done,
    session-started(session-started),
    models(list<model-info>),
    skills(list<agent-skill>),
    rate-limits(rate-limits),
    /// The working directory prepared for the thread.
    environment-ready(string),
    environment-changes(environment-changes),
    environment-diff(environment-diff),
    /// What `deliver` did, in a sentence for the user.
    environment-delivered(string),
    /// A tree of UI nodes, as JSON. A node is an object with a `type` out of a
    /// fixed set (`stack`, `row`, `heading`, `text`, `markdown`, `code`, `badge`,
    /// `keyValues`, `table`, `button`, `input`, `divider`); the app draws what it
    /// knows and skips the rest, so a plugin cannot put anything else on screen.
    ui-tree(string),
    command-result(command-result),
    /// The answer is not known yet: it will be given through `completions.complete`
    /// with this token, which the plugin picks. For work that waits on a process.
    deferred(u64),
  }
}

/// Always available.
interface log {
  enum level { debug, info, warn, error }
  log: func(level: level, message: string);
}

/// Always available. Answers a request whose `handle` returned `deferred`.
interface completions {
  use types.{outcome};
  /// `token` is the one returned in `deferred`. The answer itself cannot be `deferred`.
  complete: func(token: u64, answer: result<outcome, string>) -> result<_, string>;
}

/// Permission `deltas`. Hand deltas to the core's assembler.
interface deltas {
  use types.{thread-id, delta};
  emit: func(thread: thread-id, deltas: list<delta>) -> result<_, string>;
}

/// Permission `kv`. A private key-value store that survives restarts.
interface kv {
  get: func(key: string) -> result<option<list<u8>>, string>;
  put: func(key: string, value: list<u8>) -> result<_, string>;
  remove: func(key: string) -> result<_, string>;
  keys: func(prefix: string) -> result<list<string>, string>;
}

/// Permission `timers`.
interface timers {
  /// Fire a `timer` event once after `delay-ms`. Returns the timer id.
  start: func(delay-ms: u64) -> result<u64, string>;
  cancel: func(timer: u64);
}

/// Permission `process`, which lists the executables the plugin may run.
interface process {
  record spawn-options {
    program: string,
    args: list<string>,
    /// Added to a minimal base environment; the daemon's own is not inherited.
    env: list<tuple<string, string>>,
    cwd: option<string>,
  }

  /// Start a process. Its output and exit arrive as events carrying the returned id.
  spawn: func(options: spawn-options) -> result<u64, string>;
  write-stdin: func(process: u64, data: list<u8>) -> result<_, string>;
  close-stdin: func(process: u64) -> result<_, string>;
  kill: func(process: u64) -> result<_, string>;
}

/// Permission `threads`. Create and drive threads like a client of the daemon:
/// the base of orchestration. Not available during `init`.
interface threads {
  use types.{thread-id, thread-info, permission-mode, provider-info};

  record spawn-options {
    /// A provider id, as `qcc plugin list` shows it.
    provider: string,
    /// An absolute directory; what the environment is made from, if one is named.
    /// Absent: a directory of the plugin's own, which the daemon makes.
    cwd: option<string>,
    prompt: option<string>,
    model: option<string>,
    effort: option<string>,
    parent: option<thread-id>,
    environment: option<string>,
    base: option<string>,
    permission-mode: option<permission-mode>,
    /// Skills the thread gets on top of those every session gets: the names of
    /// skills offered on request.
    skills-enabled: list<string>,
    /// Skills every session gets that this thread goes without.
    skills-disabled: list<string>,
    /// A thread for the plugin's own use, which clients leave out of their lists
    /// and overviews.
    hidden: bool,
  }

  enum role { user, agent }

  record message {
    role: role,
    text: string,
  }

  spawn: func(options: spawn-options) -> result<thread-info, string>;
  /// Send a message; queued behind a running turn.
  send: func(thread: thread-id, text: string) -> result<_, string>;
  get: func(thread: thread-id) -> result<thread-info, string>;
  /// The user's messages and the agent's replies, oldest first.
  transcript: func(thread: thread-id) -> result<list<message>, string>;
  /// Deliver one `thread-settled` event when the thread is next idle, failed or
  /// archived; right away if it is already. Watches do not outlive the daemon.
  watch: func(thread: thread-id) -> result<_, string>;
  /// Ask for one patch of everything the thread changed, as `qcc thread diff`
  /// shows it. The environment that knows may take a while, so the answer comes
  /// later as a `thread-diff` event with the returned id.
  diff: func(thread: thread-id) -> result<u64, string>;
  /// Ask which files the thread changed, with their line counts, its branch and
  /// base, as `qcc thread changes` shows them. Answered like `diff`, by a
  /// `thread-changes` event with the returned id.
  changes: func(thread: thread-id) -> result<u64, string>;
  /// Turn one of the plugin's own skills on or off in a thread, as the user can.
  set-skill: func(thread: thread-id, skill: string, enabled: bool) -> result<_, string>;
  /// The agents the daemon can run now.
  providers: func() -> result<list<provider-info>, string>;
  /// Ask which models an agent offers, as `qcc provider models` shows them. The
  /// daemon may have to ask the agent, so the answer comes later as a
  /// `provider-models` event with the returned id; from the daemon's cache unless
  /// `refresh`. An empty list: the agent does not say.
  models: func(provider: string, refresh: bool) -> result<u64, string>;
}

/// Always available: a plugin redraws only its own views. Tell the app that a view
/// of the plugin shows something else now, so that it asks for it again; for one
/// thread's copy of a thread view, or every copy when `thread` is absent.
interface views {
  use types.{thread-id};
  refresh: func(view: string, thread: option<thread-id>) -> result<_, string>;
}

/// Permission `comments`. Leave remarks on lines of a thread's changes and read
/// them, like the user does in the app. A comment the plugin leaves carries its
/// id as the author, which the host sets: a plugin cannot speak for the user or
/// for another plugin.
interface comments {
  use types.{thread-id};

  /// Which side of the diff a line number counts on.
  enum diff-side {
    /// The code before the change: a deleted line.
    old,
    /// The code after the change: an added or unchanged line.
    new,
  }

  /// Who left a comment, beyond the plugin itself.
  record comment-author {
    /// Who in the plugin: a reviewer's name.
    name: string,
    /// The thread whose work the comment is, if any (a reviewer's).
    thread: option<thread-id>,
    /// How much it matters, in the plugin's own words (`high`, `low`).
    severity: option<string>,
    /// The changes moved on since the comment was made: the line may be off.
    stale: bool,
  }

  record new-comment {
    thread: thread-id,
    /// The file, as the thread's diff names it.
    path: string,
    /// 1-based, counted on `side`.
    line: u32,
    side: diff-side,
    /// The text of the line, to find it by when the code moves.
    quote: option<string>,
    text: string,
    author: comment-author,
  }

  record line-comment {
    id: string,
    thread: thread-id,
    path: string,
    line: u32,
    side: diff-side,
    quote: option<string>,
    text: string,
    /// Milliseconds since the Unix epoch.
    created-at: u64,
    /// When it was dealt with; absent while it is open.
    resolved-at: option<u64>,
    resolution: option<string>,
    /// The plugin that left it; absent for the user's own comments.
    plugin: option<string>,
    author: option<comment-author>,
    /// When it was last handed to the agent with a message.
    sent-at: option<u64>,
  }

  add: func(comment: new-comment) -> result<line-comment, string>;
  /// The thread's comments, oldest first; resolved ones only if asked for.
  %list: func(thread: thread-id, include-resolved: bool) -> result<list<line-comment>, string>;
  /// Mark comments the plugin left dealt with, saying what became of them; or,
  /// with `reopen`, open them again. Comments of others are refused.
  resolve: func(ids: list<string>, resolution: option<string>, reopen: bool) -> result<_, string>;
  /// Hand comments to the thread's agent with a message, the way the user's "send
  /// to agent" does: queued behind a running turn, each comment in full with how
  /// to resolve it. Needs the `threads` permission too.
  send: func(thread: thread-id, ids: list<string>, text: string) -> result<_, string>;
}

/// Permission `files`. Read text files where a thread works and in the plugin's
/// own data folder; nothing else. For settings and instructions people keep next to
/// their code, such as `.qcc/<something>/*.md`.
interface files {
  use types.{thread-id};

  variant root {
    /// The working directory of the thread.
    thread(thread-id),
    /// The plugin's own folder in qcc's data: `<data>/plugin-data/<plugin-id>`.
    %own,
  }

  /// The text of a file, up to 1 MiB; none when there is no such file. `path` is
  /// relative to the root and cannot leave it, through `..` or a link.
  read: func(root: root, path: string) -> result<option<string>, string>;
  /// The names in a folder, sorted; empty when there is no such folder.
  %list: func(root: root, dir: string) -> result<list<string>, string>;
}

/// Permission `notifications`. Tell the user something on their desktop.
interface notifications {
  use types.{thread-id};

  record notification {
    /// One line: what it is about.
    title: string,
    /// A sentence or two, plain text.
    body: string,
    /// The thread it is about. The app opens it when the user clicks the
    /// notification, where the desktop lets it.
    thread: option<thread-id>,
    /// Not worth showing while the user looks at `thread` in a focused window.
    quiet-when-shown: bool,
  }

  /// Hand a notification to every desktop app connected to the daemon, which shows
  /// it the way its system shows notifications. With no app connected it is
  /// dropped: notifications are not kept for later.
  show: func(notification: notification) -> result<_, string>;
}

world plugin {
  import log;
  import completions;
  import deltas;
  import kv;
  import timers;
  import process;
  import threads;
  import comments;
  import files;
  import views;
  import notifications;

  use types.{contribution, event, outcome};

  /// Called once after instantiation. Declares what the plugin contributes.
  export init: func() -> result<list<contribution>, string>;

  /// Called for every event addressed to the plugin, one at a time.
  export handle: func(event: event) -> result<outcome, string>;
}
